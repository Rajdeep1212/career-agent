# Public application settings
APP_NAME=Career Agent
# The only browser origin allowed to change data (scheme://host:port, no path).
APP_ORIGIN=http://localhost:8010
# Comma-separated job providers; a provider without its key is skipped.
JOB_PROVIDERS=radar,alerts,jsearch,adzuna,jooble
SEARCH_COUNTRY=in
VERIFICATION_CONCURRENCY=4
# The dashboard asks before a search that will send at least this many provider requests.
SEARCH_WARN_REQUESTS=5
# Aggregator results are reused for this many hours (0 turns the cache off).
SEARCH_CACHE_HOURS=12

# JSearch through RapidAPI
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
# Free plan: 200 requests/month. The Company Radar sync sends one recent-jobs request a day;
# searches reuse it and cached results, and query JSearch again only on "Refresh job sites".
JSEARCH_MONTHLY_LIMIT=200
# Empty = your saved roles joined with OR (check OR support once: python -m app.sources.jsearch_probe)
JSEARCH_DAILY_QUERY=
JSEARCH_DAILY_DATE_POSTED=3days

# Adzuna (free key: https://developer.adzuna.com/). Default limits: 25/minute, 250/day.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (free key: https://in.jooble.org/api/about). A key works only on the country
# site it was issued for; the free plan allows 500 requests per key in total.
JOOBLE_API_KEY=
JOOBLE_HOST=in.jooble.org
# Free-plan limits, counted on this machine because these APIs do not report usage.
# Raise them only if the provider has granted you more.
ADZUNA_DAILY_LIMIT=250
ADZUNA_MONTHLY_LIMIT=2500
JOOBLE_KEY_LIMIT=500

# Optional Gmail OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/auth/google/callback

# Optional LinkedIn OpenID Connect integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8010/auth/linkedin/callback

# Generate locally and keep only in .env:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

REQUEST_TIMEOUT_SECONDS=20
VERIFY_SSL=true

# Optional conversational assistance. "none" preserves deterministic-only behavior.
CHAT_MODEL_PROVIDER=none
CHAT_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash
CHAT_MODEL_STRUCTURED_OUTPUT=false
CHAT_MODEL_TOOL_CALLING=false
CHAT_MODEL_TIMEOUT_SECONDS=45
LANGGRAPH_CHECKPOINT_PATH=data/langgraph.sqlite3

# Hosted demo only: synthetic profile and jobs in DEMO_DATA_DIR; every credential
# above is ignored, OAuth/email are unavailable and outbound HTTP is blocked.
DEMO_MODE=false
# DEMO_DATA_DIR must be separate from DATA_DIR (defaults to a temp folder).

# Job-alert emails (optional): a DEDICATED Gmail account that only receives forwarded
# LinkedIn/Naukri/Indeed alerts. Never your main account. Use a Google app password
# (2-Step Verification must be on) and enable IMAP in that account's Gmail settings.
# Without these the step is skipped; .eml files in data/alert_dropbox/ still work.
ALERTS_IMAP_HOST=
ALERTS_IMAP_USER=
ALERTS_IMAP_APP_PASSWORD=
ALERTS_IMAP_FOLDER=INBOX
ALERTS_LOOKBACK_DAYS=14
