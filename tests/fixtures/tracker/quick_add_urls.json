  "cases": [
    {"name": "tracking parameters, upper-case host and a fragment",
     "url": "https://Boards.Greenhouse.io/acmerobotics/jobs/4012345?gh_src=abc123&utm_source=linkedin&utm_medium=social#app",
     "expect": "matched", "job_id": "acme:4012345"},
    {"name": "trailing slash",
     "url": "https://boards.greenhouse.io/acmerobotics/jobs/4012399/", "expect": "matched", "job_id": "acme:4012399"},
    {"name": "the apply page of a posting",
     "url": "https://jobs.lever.co/northwind/a1b2c3d4-1111-2222-3333-444455556666/apply?lever-source=LinkedIn",
     "expect": "matched", "job_id": "northwind:a1b2c3d4-1111-2222-3333-444455556666"},
    {"name": "a job id in the query string is kept, tracking around it is dropped",
     "url": "https://careers.globex.example/open-roles?utm_campaign=x&gh_jid=7731&ref=newsletter",
     "expect": "matched", "job_id": "globex:7731"},
    {"name": "another job id in the query string is another job",
     "url": "https://careers.globex.example/open-roles?gh_jid=9999", "expect": "none"},
    {"name": "another posting on the same board, URL only",
     "url": "https://boards.greenhouse.io/acmerobotics/jobs/5550000", "expect": "none"},
    {"name": "same company and title on another URL",
     "url": "https://www.acmerobotics.example/careers/data-engineer", "title": "Data Engineer", "company": "Acme Robotics India",
     "expect": "probable", "candidates": ["acme:4012399"]},
    {"name": "a similar title at the same company",
     "url": "https://www.acmerobotics.example/careers/mle", "title": "Machine Learning Engineer I", "company": "Acme Robotics",
     "expect": "probable", "candidates": ["acme:4012345"]},
    {"name": "the title is open in two cities: both are offered, none is chosen",
     "url": "https://northwind.example/jobs/graduate-swe", "title": "Graduate Software Engineer", "company": "Northwind Labs",
     "expect": "probable",
     "candidates": ["northwind:a1b2c3d4-1111-2222-3333-444455556666", "northwind:b2c3d4e5-1111-2222-3333-444455556666"]},
    {"name": "a city narrows it to one",
     "url": "https://northwind.example/jobs/graduate-swe", "title": "Graduate Software Engineer", "company": "Northwind Labs",
     "location": "Chennai", "expect": "probable", "candidates": ["northwind:b2c3d4e5-1111-2222-3333-444455556666"]},
    {"name": "same title at another company",
     "url": "https://initech.example/jobs/12", "title": "Backend Engineer", "company": "Initech", "expect": "none"},
    {"name": "same company, a different role",
     "url": "https://www.acmerobotics.example/careers/hr", "title": "HR Business Partner", "company": "Acme Robotics",
