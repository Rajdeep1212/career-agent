     "description": "SQL and Python."},
    {"company_id": "northwind", "source_job_id": "a1b2c3d4-1111-2222-3333-444455556666", "company": "Northwind Labs Pvt. Ltd.",
     "title": "Graduate Software Engineer", "location": "Hyderabad, India",
     "url": "https://jobs.lever.co/northwind/a1b2c3d4-1111-2222-3333-444455556666", "description": "2026 graduates."},
